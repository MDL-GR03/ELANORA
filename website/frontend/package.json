{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:docker": "vite --mode dev-docker",
    "build": "vite build --mode prod",
    "build:server": "vite build --mode server",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --check ./src",
    "format:fix": "prettier --write ./src",
    "stylelint": "stylelint \"src/**/*.{css,vue}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,vue}\" --fix",
    "i18n:report": "vue-i18n-extract report --vueFiles \"src/**/*.vue\" --languageFiles \"src/locales/*.json\"",
    "i18n:check": "node scripts/check-i18n-parity.cjs",
    "i18n:extract": "vue-i18n-extract extract --vueFiles \"src/**/*.vue\" --languageFiles \"src/locales/*.json\" --add",
    "i18n:clean-empty": "node scripts/clean-vue-i18n-extraction.js",
    "i18n:extract-clean": "npm run i18n:extract && npm run i18n:clean-empty",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@unhead/vue": "^3.4.1",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vee-validate": "^4.15.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-vue": "^10.11.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-i18n-extract": "^2.0.7"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.27"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,vue}": [
      "npx eslint --fix --config eslint.config.js",
      "npx prettier --config .prettierrc.json --write"
    ],
    "src/**/*.{css,vue}": [
      "npx stylelint --fix --config .stylelintrc"
    ],
    "*.{json,md,yml,yaml}": [
      "npx prettier --config .prettierrc.json --write"
    ]
  }
}

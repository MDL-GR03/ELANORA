# Use a Node.js image to build the app
FROM node:24-alpine AS build-stage

# Build mode selects which .env.* file Vite reads to bake VITE_API_URL into the
# bundle: "prod" for the local/staging stack (separate frontend/backend ports),
# "server" for the internet-facing stack behind nginx. Defaults to prod so the
# prod compose file needs no extra configuration.
ARG BUILD_MODE=prod
ENV BUILD_MODE=${BUILD_MODE}

# Set the working directory
WORKDIR /app

# Copy the package.json and package-lock.json to install dependencies
COPY ./package*.json ./

# Install dependencies
RUN npm ci --ignore-scripts

# Copy only necessary files for the build
COPY ./src ./src
COPY ./public ./public
COPY ./vite.config.js ./
COPY ./tailwind.config.js ./
COPY ./index.html ./

# Build the Vue.js app for production. Called directly via npx so the build
# mode is controlled by BUILD_MODE rather than hardcoded in package.json's
# build script. Both modes produce the same nginx-served static bundle; the
# mode only selects which .env.* file supplies VITE_API_URL.
RUN npx vite build --mode ${BUILD_MODE}

# Use an official Nginx image to serve the app
FROM nginx:stable-alpine-slim AS production-stage

# Install envsubst for environment variable substitution
RUN apk add --no-cache gettext

# Copy the built files from the build stage into the Nginx container
COPY --from=build-stage /app/dist /usr/share/nginx/html

# Copy nginx config template
COPY ./docker/nginx.conf /etc/nginx/templates/default.conf.template

# Create the static directory and set proper permissions
RUN mkdir -p /app/static && \
    chown -R nginx:nginx /app/static && \
    chmod -R 755 /app/static

# Create entrypoint script to substitute variables and start nginx
RUN echo '#!/bin/sh' > /docker-entrypoint.sh && \
    echo 'envsubst "\\$NGINX_SERVER_NAME \\$NGINX_BACKEND_HOST \\$NGINX_BACKEND_PORT \\$NGINX_STATIC_FILES" < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf' >> /docker-entrypoint.sh && \
    echo 'exec nginx -g "daemon off;"' >> /docker-entrypoint.sh && \
    chmod +x /docker-entrypoint.sh

# Expose port 80
EXPOSE 80

CMD ["/docker-entrypoint.sh"]

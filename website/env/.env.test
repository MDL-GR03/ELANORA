# This file is used to store environment variables for the project in CI test mode

####################################
# GLOBAL ENVIRONMENT CONFIGURATION #
####################################
ENVIRONMENT=test

##############################
#   DATABASE CONFIGURATION   #
##############################
DB_NAME=elanora_test
# PostgreSQL application account
DB_USER=elanora_test
DB_PASSWORD=elanora-test-only
# Host and port for PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432

#########################
#   JWT CONFIGURATION   #
#########################
# Secret key for JWT
JWT_SECRET_KEY=test-secret-key-for-ci-only
# One-time token shown to the institution administrator during browser setup
SETUP_TOKEN=test-setup-token-for-ci-only
JWT_ALGORITHM=HS256
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_TOKEN_EXPIRE_MINUTES=15

#########################
# FASTAPI CONFIGURATION #
#########################
# Host address for frontend
FRONTEND_HOST=http://localhost:8777
# Hostname for backend
BACKEND_HOST=http://localhost:8018

###############################
# ELAN PROJECTS CONFIGURATION #
###############################
# Base path for storing ELAN projects (relative to backend app directory)
ELAN_PROJECTS_BASE_PATH=elanora_projects
# Maximum file size for ELAN uploads (in MB)
ELAN_MAX_FILE_SIZE_MB=50
# Maximum total size for batch uploads (in MB)
ELAN_MAX_BATCH_SIZE_MB=500

##############################
#     MAIL CONFIGURATION     #
##############################
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=test@ci.example.org
MAIL_PORT=1025
MAIL_SERVER=mailpit
MAIL_STARTTLS=false
MAIL_SSL_TLS=false
MAIL_USE_CREDENTIALS=false

###############################
#   ENCRYPTION & BACKUP KEYS  #
###############################
# Encryption keys for outbox
OUTBOX_ENCRYPTION_KEYS=test-encryption-key-for-ci-only
# Passphrase for the installation's encrypted off-host backups
ELANORA_BACKUP_PASSPHRASE=test-backup-passphrase-for-ci-only

##############################
#     VITE CONFIGURATION     #
##############################
VITE_API_URL=http://localhost:8018/api/v1

##############################
#          LOG LEVEL         #
##############################
LOG_LEVEL=DEBUG
CONSOLE_LOG_LEVEL=INFO
ROOT_LOG_LEVEL=WARNING
EXCEPTION_LOG_LEVEL=WARNING
EXCEPTION_LOG_DIR=app/logs/exceptions
LOG_DIR=app/logs
APP_NAME=elanora

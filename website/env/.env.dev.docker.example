# Copy to .env.dev.docker for Docker-based local development:
#   cp website/env/.env.dev.docker.example website/env/.env.dev.docker
#
# DB_HOST, DB_PORT, and storage paths are set by docker-compose.yml to
# container-internal values; do not set them here.

####################################
# GLOBAL ENVIRONMENT CONFIGURATION #
####################################
ENVIRONMENT=dev

##############################
#   DATABASE CONFIGURATION   #
##############################
DB_NAME=elanora
DB_USER=elanora
# Must match the dev database container's POSTGRES_PASSWORD.
# To change it, also set ELANORA_DEV_DB_PASSWORD in your shell.
DB_PASSWORD=elanora-local-only
ELANORA_BACKUP_PASSPHRASE=elanora-local-backup-passphrase-not-for-production

#########################
#   JWT CONFIGURATION   #
#########################
JWT_SECRET_KEY=elanora-local-jwt-secret-not-for-production
SETUP_TOKEN=elanora-local-setup
JWT_ALGORITHM=HS256
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_TOKEN_EXPIRE_MINUTES=15

#########################
# FASTAPI CONFIGURATION #
#########################
FRONTEND_HOST=http://localhost:8777
BACKEND_HOST=http://localhost:8018

###############################
# ELAN PROJECTS CONFIGURATION #
###############################
ELAN_MAX_FILE_SIZE_MB=50
ELAN_MAX_BATCH_SIZE_MB=500

##############################
#     MAIL CONFIGURATION     #
##############################
# Routed to Mailpit (local SMTP catcher) by the dev Compose stack.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=mailer@dev.elanora.example.org
MAIL_PORT=1025
MAIL_SERVER=mailpit
MAIL_STARTTLS=false
MAIL_SSL_TLS=false
MAIL_USE_CREDENTIALS=false

###############################
#   ENCRYPTION & BACKUP KEYS  #
###############################
OUTBOX_ENCRYPTION_KEYS=svzSYyqHlCqGnZmcGdjsp3qNN6HvwqEAAkhiJCMdrtk=

##############################
#     VITE CONFIGURATION     #
##############################
VITE_API_URL=http://localhost:8018/api/v1

##############################
#          LOG LEVEL         #
##############################
LOG_LEVEL=DEBUG
CONSOLE_LOG_LEVEL=INFO
ROOT_LOG_LEVEL=WARNING
EXCEPTION_LOG_LEVEL=WARNING
EXCEPTION_LOG_DIR=app/logs/exceptions
LOG_DIR=app/logs
APP_NAME=elanora

# Copy to .env.dev for running Poetry and Vite directly on the host.
ENVIRONMENT=dev

DB_NAME=elanora
DB_USER=elanora
DB_PASSWORD=elanora-local-only
DB_HOST=localhost
DB_PORT=5416

JWT_SECRET_KEY=elanora-local-jwt-secret-not-for-production
SETUP_TOKEN=elanora-local-setup
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_HOST=http://localhost:8777
BACKEND_HOST=http://localhost:8018
VITE_API_URL=http://localhost:8018/api/v1

ELAN_PROJECTS_BASE_PATH=website/data/elanora_projects
ELAN_BACKUPS_BASE_PATH=website/data/recovery-cache
INSTANCE_ASSETS_BASE_PATH=website/data/instance-assets
# Keep local storage for development. Set ASSET_STORAGE_BACKEND=s3 and configure
# ASSET_S3_* below to exercise an S3-compatible service such as MinIO.
ASSET_STORAGE_BACKEND=local
# ASSET_S3_BUCKET=elanora-assets
# ASSET_S3_PREFIX=elanora
# ASSET_S3_REGION=eu-west-1
# ASSET_S3_ENDPOINT_URL=http://localhost:9000
# ASSET_S3_ACCESS_KEY_ID=
# ASSET_S3_SECRET_ACCESS_KEY=
SYNC_STAGING_BASE_PATH=website/data/sync-staging
ELAN_MAX_FILE_SIZE_MB=50
ELAN_MAX_BATCH_SIZE_MB=500
INTEGRITY_SCAN_ON_STARTUP=true

LOG_LEVEL=INFO

# Local SMTP catcher provided by the development Compose stack.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=mailer@dev.elanora.example.org
MAIL_PORT=1025
MAIL_SERVER=mailpit
MAIL_STARTTLS=false
MAIL_SSL_TLS=false
MAIL_USE_CREDENTIALS=false
OUTBOX_ENCRYPTION_KEYS=svzSYyqHlCqGnZmcGdjsp3qNN6HvwqEAAkhiJCMdrtk=

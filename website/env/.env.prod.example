# Copy to .env.prod outside source control and replace every placeholder.
ENVIRONMENT=prod

DB_NAME=elanora
DB_USER=elanora
DB_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
SETUP_TOKEN=replace-with-a-long-random-one-time-setup-token

FRONTEND_HOST=https://elanora.example.org
BACKEND_HOST=https://elanora.example.org
VITE_API_URL=/api/v1

ELAN_MAX_FILE_SIZE_MB=50
ELAN_MAX_BATCH_SIZE_MB=500

# New passwords are checked against Have I Been Pwned's range API, which only
# ever receives the first five characters of the password's SHA-1 hash. Set to
# false for an installation without internet access; the shipped list of
# common passwords still applies.
PASSWORD_BREACH_CHECK=true
INSTANCE_ASSETS_BASE_PATH=/var/lib/elanora/instance-assets
# Use s3 for multi-node deployments. Prefer workload identity; only set the two
# credential variables when the platform cannot provide short-lived credentials.
ASSET_STORAGE_BACKEND=local
# ASSET_S3_BUCKET=elanora-assets
# ASSET_S3_PREFIX=elanora
# ASSET_S3_REGION=eu-west-1
# ASSET_S3_ENDPOINT_URL=
# ASSET_S3_ACCESS_KEY_ID=
# ASSET_S3_SECRET_ACCESS_KEY=
SYNC_STAGING_BASE_PATH=/var/lib/elanora/sync-staging
INTEGRITY_SCAN_ON_STARTUP=true

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_USE_CREDENTIALS=true
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# For rotation, put the new key first and retain old keys comma-separated until the queue is drained.
OUTBOX_ENCRYPTION_KEYS=replace-with-a-generated-fernet-key

NGINX_SERVER_NAME=elanora.example.org
NGINX_BACKEND_HOST=backend
NGINX_BACKEND_PORT=8010
NGINX_STATIC_FILES=/static/

LOG_LEVEL=INFO

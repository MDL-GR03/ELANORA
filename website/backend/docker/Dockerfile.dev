# Use python:alpine which is a stripped-down version of Python using Alpine Linux
FROM python:3.13-alpine3.21

# APK is the package manager for Alpine Linux, and musl-dev/gcc are required for building some Python packages
# Also installing Poetry in the same layer
RUN apk add --no-cache gcc git musl-dev && \
    pip install --no-cache-dir "poetry==2.4.2"

# Set workdir
WORKDIR /app

# Copy only Poetry files first for better caching
COPY pyproject.toml poetry.lock ./

# Install dependencies (no venv, system-wide for Docker)
RUN poetry config virtualenvs.create false \
    && poetry install --no-root --no-interaction --no-ansi

# Copy the rest of your app
COPY . .

# Install the local package and its `elanora-bootstrap` command after its source
# exists. Keeping this separate preserves the dependency cache during editing.
RUN poetry install --only-root --no-interaction --no-ansi

# Expose port
EXPOSE 8018

# Start the explicit ASGI server with development reload support.
CMD ["uvicorn", "app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8018"]
